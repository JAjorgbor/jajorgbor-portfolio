# Sanity project (sanity.io/manage → your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01

# Canonical origin for social images, sitemap and robots (no trailing slash).
# On Vercel this can be left unset; the production URL is used.
NEXT_PUBLIC_SITE_URL=

# Server-only token with Editor permissions (API → Tokens).
# Used to save contact form submissions and to run `pnpm seed`.
SANITY_API_WRITE_TOKEN=
